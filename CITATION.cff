    orcid: "https://orcid.org/0000-0002-0852-6002"
    affiliation: "St. Elisabeth Gruppe GmbH, Klinikum der Ruhr-Universität Bochum, Herne, Germany"

keywords:
  - REDCap
  - REDCap External Module
  - survey authentication
  - access control
  - public dashboard
  - public report
  - clinical research
  - registry

license: "MIT"

